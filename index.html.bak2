    <!-- Arbeitsweise -->
    <section id="workflow" class="workflow-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">Arbeitsweise</span>
                <h2><span class="section-initial">V</span>on der Anfrage<br>zur fertigen Website.</h2>
                <p class="section-subtitle">
                    Ein nachvollziehbarer Ablauf, bei dem Sie jederzeit wissen, in welcher Phase sich Ihr Projekt befindet.
                </p>
            </div>

            <div class="workflow-steps">
                <div class="workflow-step">
                    <div class="step-number">1</div>
                    <h3>Erstgespräch</h3>
                    <p>Wir besprechen Ihre Ziele, Anforderungen und Vorstellungen für Ihre neue Website.</p>
                </div>
                <div class="workflow-step">
                    <div class="step-number">2</div>
                    <h3>Konzept & Design</h3>
                    <p>Wir entwickeln ein individuelles Konzept und Design, das auf Ihre Marke und Zielgruppe zugeschnitten ist.</p>
                </div>
                <div class="workflow-step">
                    <div class="step-number">3</div>
                    <h3>Umsetzung</h3>
                    <p>Die technische Umsetzung erfolgt mit sauberem Code, responsivem Design und SEO-Grundlagen.</p>
                </div>
                <div class="workflow-step">
                    <div class="step-number">4</div>
                    <h3>Go-Live & Betreuung</h3>
                    <p>Nach der Veröffentlichung stehen wir für Wartung, Updates und weitere Optimierungen zur Verfügung.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Kontakt -->
    <section id="kontakt" class="kontakt-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">Kontakt</span>
                <h2><span class="section-initial">B</span>ereit für Ihre<br>neue Website?</h2>
                <p class="section-subtitle">Schreiben Sie mir – ich melde mich innerhalb von 24 Stunden.</p>
            </div>

            <div class="kontakt-vcard-grid">
                <div class="kontakt-form-col">
                    <div class="kontakt-card">
                        <form id="kontaktForm" class="kontakt-form" action="https://api.web3forms.com/submit" method="POST">
                            <input type="hidden" name="access_key" value="2ea00a9f-83c1-4240-a87c-0bb181b3530d">
                            <input type="hidden" name="subject" value="Neue Anfrage von lensonconsulting.de">
                            <input type="hidden" name="from_name" value="Lenson Consulting Website">
                            
                            <div class="row">
                                <div class="col-md-6 mb-3"><label for="name" class="form-label">Name *</label><input type="text" class="form-control" id="name" name="name" required></div>
                                <div class="col-md-6 mb-3"><label for="email" class="form-label">E-Mail *</label><input type="email" class="form-control" id="email" name="email" required></div>
                            </div>
                            <div class="mb-3"><label for="nachricht" class="form-label">Ihre Nachricht *</label><textarea class="form-control" id="nachricht" name="nachricht" rows="4" required placeholder="Erzählen Sie mir von Ihrem Projekt..."></textarea></div>
                            <div class="mb-3 form-check"><input type="checkbox" class="form-check-input" id="datenschutz" required><label class="form-check-label" for="datenschutz">Ich habe die <a href="datenschutz.html" class="text-gold" target="_blank">Datenschutzerklärung</a> gelesen und stimme zu. *</label></div>
                            <button type="submit" class="btn btn-gold btn-lg w-100"><i class="bi bi-send"></i> Unverbindliche Anfrage senden</button>
                        </form>
                        <div id="formMessage"></div>
                    </div>
                </div>

                <div class="vcard-col">
                    <div class="vcard-wrapper">
                        <div class="vcard" id="vcardDownload">
                            <div class="vcard-inner">
                                <div class="vcard-content">
                                    <div class="vcard-header">
                                        <img src="assets/images/logo.png" alt="Lenson Consulting Logo" class="vcard-logo">
                                        <div class="vcard-name-group">
                                            <h3 class="vcard-name">Robin Lenson</h3>
                                            <span class="vcard-title">Webdesign & Consulting</span>
                                        </div>
                                    </div>
                                    <div class="vcard-divider"></div>
                                    <div class="vcard-details">
                                        <div class="vcard-detail"><i class="bi bi-telephone-fill"></i><a href="tel:+4917662145153">+49 176 62145153</a></div>
                                        <div class="vcard-detail"><i class="bi bi-envelope-fill"></i><a href="mailto:info@lensonconsulting.de">info@lensonconsulting.de</a></div>
                                        <div class="vcard-detail"><i class="bi bi-globe2"></i><a href="https://lensonconsulting.de" target="_blank">lensonconsulting.de</a></div>
                                        <div class="vcard-detail"><i class="bi bi-geo-alt-fill"></i><span>Mannheim, Deutschland</span></div>
                                    </div>
                                    <div class="vcard-footer-text">
                                        <span>Lenson Consulting</span>
                                        <span class="vcard-dot">·</span>
                                        <span>Hochwertiges Webdesign & individuelle Weblösungen</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="vcard-actions">
                            <button class="vcard-btn vcard-btn-download" onclick="downloadVCard()" title="Als Kontakt speichern"><i class="bi bi-download"></i><span>Speichern</span></button>
                            <button class="vcard-btn vcard-btn-qr" onclick="toggleQR()" title="QR-Code anzeigen"><i class="bi bi-qr-code"></i><span>QR-Code</span></button>
                            <a href="https://wa.me/4917662145153" target="_blank" class="vcard-btn vcard-btn-whatsapp" title="WhatsApp"><i class="bi bi-whatsapp"></i><span>WhatsApp</span></a>
                        </div>
                        <div class="vcard-qr-modal" id="qrModal">
                            <div class="vcard-qr-card">
                                <button class="vcard-qr-close" onclick="toggleQR()">✕</button>
                                <h3>QR-Code scannen</h3>
                                <div class="vcard-qr-code" id="qrCode"></div>
                                <p>Scannen Sie diesen Code mit Ihrer Kamera, um den Kontakt zu speichern.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

